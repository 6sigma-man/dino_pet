{
  "name": "dinopet",
  "version": "1.2.0",
  "description": "轻量、可爱、不打扰工作的开源桌面恐龙宠物",
  "main": "dist/main/main.js",
  "author": "DinoPet Contributors",
  "license": "MIT",
  "private": true,
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json && tsc -p tsconfig.renderer.json",
    "build:win": "npm run build && electron-builder --win",
    "dev": "npm run build && electron . --dev",
    "start": "npm run build && electron .",
    "test": "npm run build && tsc -p tsconfig.unittest.json && node --test \"tests/**/*.test.js\"",
    "lint": "tsc -p tsconfig.json --noEmit && tsc -p tsconfig.renderer.json --noEmit"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "electron": "^37.0.0",
    "electron-builder": "^26.15.3",
    "pngjs": "^7.0.0",
    "typescript": "^5.9.0"
  },
  "dependencies": {
    "uiohook-napi": "^1.5.5"
  }
}
